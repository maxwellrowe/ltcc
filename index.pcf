	<ouc:properties label="config">
		<parameter name="alert-banner" type="checkbox" group="Everyone" prompt="Alert Banner" >
<option value="yes" selected="false">Display if checked</option>
</parameter>

		<parameter name="hero-content" type="select" group="Everyone" prompt="Hero Content" alt="Select content type.">
<option value="slider" selected="false">Slider</option>
<option value="video" selected="true">Video</option>
</parameter>

		<parameter name="tagline" type="text" group="Everyone" prompt="Tagline">Mountains, deep blue water, and sheer rugged beauty--Lake Tahoe.</parameter>
		<parameter name="parallax-bg" type="filechooser" group="Everyone" prompt="Parallax Background" alt="Select a background image.">https://www.ltcc.edu/_resources/images/home-parallax-bg-image.jpg</parameter>

		<parameter section="News" name="news-heading" type="text" group="Everyone" prompt="News Heading" alt="Enter the news heading.">News</parameter>		
		<parameter name="news-link" type="filechooser" group="Everyone" prompt="News Link" alt="Select a link for news heading.">/news</parameter>
		<parameter name="news-link-title" type="text" group="Everyone" prompt="News Link Title Attribute" alt="Enter the text for the title attribute to be used on the link for the news heading.">Read More News</parameter>
		<parameter name="news-feed" type="filechooser" group="Everyone" prompt="News Feed" alt="Select an RSS feed to parse.">/rss/news.xml</parameter>
		<parameter name="news-items" type="select" group="Everyone" prompt="No. of News Items" alt="Choose the number of items to display.">
<option value="3" selected="true">3</option>
<option value="4" selected="false">4</option>
<option value="5" selected="false">5</option>
<option value="6" selected="false">6</option>
</parameter>

		<parameter section="Events" name="events-heading" type="text" group="Everyone" prompt="Events Heading" alt="Enter the events heading.">Events</parameter>		
		<parameter name="events-link" type="text" group="Everyone" prompt="Events Link" alt="Select a link for events heading.">/calendar/</parameter>
		<parameter name="events-link-title" type="text" group="Everyone" prompt="Events Link Title Attribute" alt="Enter the text for the title attribute to be used on the link for the events heading.">See More Events</parameter>	
		<parameter name="events-items" type="select" group="Everyone" prompt="No. of Event Items" alt="Choose the number of items to display.">
<option value="3" selected="false">3</option>
<option value="4" selected="false">4</option>
<option value="5" selected="false">5</option>
<option value="6" selected="true">6</option>
</parameter>
		<parameter name="events-featured" type="checkbox" group="Everyone" prompt="Show Featured Events" alt="Select to show featured events">
<option value="featured" selected="false"></option>
</parameter>
		<parameter name="events-tag" type="text" group="Everyone" prompt="Events Category " alt="Enter event categories, separated by a semicolon ( ; )."></parameter>
		<parameter name="events-filter" type="checkbox" group="Everyone" prompt="Category Filter" alt="Select if each event must have all categories">
<option value="and" selected="false">All</option>
</parameter>
	</ouc:properties>

	<ouc:properties label="metadata">
		<title>Lake Tahoe Community College | LTCC | Home of the Coyotes</title>
		<meta name="Description" content="Lake Tahoe Community College is an evolving, dynamic California community college located in the heart of South Lake Tahoe. The waters and surrounding forests of Lake Tahoe are a national treasure, and LTCC's campus is a microcosm of the entire region’s natural beauty." />
		<meta name="Keywords" content="tahoe community college, education in lake tahoe, tahoe schools, ltcc" />
	</ouc:properties>

