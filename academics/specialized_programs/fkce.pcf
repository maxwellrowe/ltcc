	<ouc:properties label="metadata">
		<title>Foster and Kinship Care (FKCE) | Lake Tahoe Community College</title>
		<meta name="Description" content="LTCC’s Foster &amp; Kinship Care Education (FKCE) program provides training, resources, and support for foster, relative, and kinship caregivers to help children thrive in safe, stable homes." />
	</ouc:properties>

