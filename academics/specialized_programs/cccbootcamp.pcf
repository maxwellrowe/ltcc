	<ouc:properties label="metadata">
		<title>California Conservation Corps Culinary Registration</title>
		<meta name="Description" content="California Conservation Corps members can register and take Culinary Art boot camp classes at Lake Tahoe Community College, with a referral from their facility. Use this page to fill out a free online form to register." />
