<!-- FEES CARD -->
<div style="flex: 1 1 300px; background-color: #fff; padding: 1.5rem; border-radius: 12px; box-shadow: 0 2px 6px rgba(0,0,0,0.05);">
<div style="text-align: center;"><img style="width: 80px; height: auto; margin-bottom: 1rem;" src="https://www.ltcc.edu/_resources/images/ltcc_images/issi/feesicon_250.jpg" alt="Fees Icon" />
<h3 style="font-size: 1.25rem; margin-bottom: 0.5rem; color: #003e51;">Fees</h3>
</div>
<p><strong>2026 California Resident Tuition:</strong></p>
<ul>
<li>$77.50 enrollment fee* ($31/unit)</li>
<li>$5 Health &amp; Student Rep Fee</li>
<li>$42 Material Fee</li>
<li>Optional 0.5 unit course: $15.50</li>
</ul>
<p><strong>2026 Out-of-State Tuition:</strong></p>
<ul>
<li>$760.00 enrollment fee* for 2.5 units ($304/unit)</li>
<li>$5 Health &amp; Student Rep Fee</li>
<li>$42 Material Fee</li>
<li>Optional 0.5 unit course: $152</li>
</ul>
<p style="font-size: 12px; text-align: left;">*All fees are subject to change</p>
<p><a href="https://www.ltcc.edu/admissions/fees.php" target="_blank" rel="noopener">More About Tuition &amp; Fees</a></p>
</div>
<!-- PLACEMENT CARD -->
