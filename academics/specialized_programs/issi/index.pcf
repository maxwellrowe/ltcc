	<ouc:properties label="metadata">
		<title>Intensive Spanish Summer Institute | Lake Tahoe Community College</title>
		<meta name="Description" content="Enhance your Spanish fluency at the Intensive Spanish Summer Institute at Lake Tahoe Community College. Join our week-long immersion program with expert native instructors, 16 language levels, cultural classes, and earn 2.5 academic credits. Enroll early!" />
	</ouc:properties>

