	<ouc:properties label="metadata">
		<title>ISSI Events | Lake Tahoe Community College</title>
		<meta name="Description" content="Explore events at LTCC’s Intensive Spanish Summer Institute (ISSI), featuring cultural activities, guest speakers, and immersive experiences that enrich Spanish language learning." />
	</ouc:properties>
	
