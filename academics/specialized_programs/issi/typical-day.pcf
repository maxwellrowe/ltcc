	<ouc:properties label="metadata">
		<title>A Typical Day at ISSI | Lake Tahoe Community College</title>
		<meta name="Description" content="Get a glimpse of a typical day at LTCC’s Intensive Spanish Summer Institute. From immersive language classes to cultural activities, see how each day is structured for dynamic learning and engagement." />
