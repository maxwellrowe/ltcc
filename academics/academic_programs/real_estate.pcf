	<ouc:properties label="metadata">
		<title>Real Estate Program | Lake Tahoe Community College</title>
		<meta name="Description" content="Launch your career in real estate with LTCC’s certificate program. Learn the fundamentals of property law, finance, and sales to prepare for the California Real Estate License exam." />
	</ouc:properties>

