	<ouc:properties label="metadata">
		<title>Mathematics Program | Lake Tahoe Community College</title>
		<meta name="Description" content="Build strong analytical and problem-solving skills with LTCC’s Mathematics program. Prepare for transfer and careers in science, engineering, technology, business, and education." />
	</ouc:properties>

