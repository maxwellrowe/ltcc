	<ouc:properties label="metadata">
		<title>Culinary Arts | Lake Tahoe Community College</title>
		<meta name="Description" content="Turn your passion for food into a career with LTCC’s Culinary Arts program. Gain hands-on experience in professional kitchens and learn the skills needed for success in the culinary industry." />
	</ouc:properties>

