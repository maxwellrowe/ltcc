	<ouc:properties label="metadata">
		<title>Internship Program | Lake Tahoe Community College</title>
		<meta name="Description" content="Gain real-world experience with LTCC’s Internship Program. Develop career skills, build professionalism, and explore job opportunities through flexible, hands-on learning experiences tailored to your academic and career goals." />
	</ouc:properties>

