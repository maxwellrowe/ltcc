	<ouc:properties label="metadata">
		<title>Physical Science Program | Lake Tahoe Community College</title>
		<meta name="Description" content="Discover the principles of chemistry, physics, and earth science with LTCC’s Physical Science program. Build a foundation for transfer or careers in science, engineering, and education." />
	</ouc:properties>

