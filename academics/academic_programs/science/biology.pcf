	<ouc:properties label="metadata">
		<title>Biology Program | Lake Tahoe Community College</title>
		<meta name="Description" content="Discover LTCC’s Biology program, offering courses in life sciences, ecology, and human biology. Prepare for careers in healthcare, research, or environmental science while learning in the beautiful Lake Tahoe region." />
	</ouc:properties>

