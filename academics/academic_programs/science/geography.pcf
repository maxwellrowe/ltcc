	<ouc:properties label="metadata">
		<title>Geography Program | Lake Tahoe Community College      </title>
		<meta name="Description" content="Study the relationship between people, places, and the environment with LTCC’s Geography program. Prepare for transfer and careers in environmental studies, planning, and geospatial fields." />
	</ouc:properties>

