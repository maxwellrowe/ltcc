	<ouc:properties label="metadata">
		<title>Environmental Science Program | Lake Tahoe Community College</title>
		<meta name="Description" content="Explore LTCC’s Environmental Science program and study the natural world through hands-on fieldwork and coursework. Prepare for careers in sustainability, conservation, and environmental policy." />
