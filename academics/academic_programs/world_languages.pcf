	<ouc:properties label="metadata">
		<title>World Languages in Spanish | Lake Tahoe Community College</title>
		<meta name="Description" content="Explore LTCC’s Spanish program within World Languages. Build fluency and cultural understanding through engaging coursework designed for all proficiency levels." />
