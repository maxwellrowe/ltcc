	<ouc:properties label="metadata">
		<title> Wilderness Education &amp; Outdoor Leadership Program | Avalanche Courses | Lake Tahoe Community College</title>
		<meta name="Description" content="Explore Lake Tahoe Community College’s Wilderness Education and Outdoor Leadership Program. Develop leadership and technical skills through immersive courses like avalanche courses, in the Sierra Nevada, earning industry-recognized certifications from top organizations. Join us for a transformative learning experience." />
	</ouc:properties>

