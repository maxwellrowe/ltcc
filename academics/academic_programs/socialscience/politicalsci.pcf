	<ouc:properties label="metadata">
		<title>Political Science Program | Lake Tahoe Community College</title>
		<meta name="Description" content="Study government, politics, and public policy with LTCC’s Political Science program. Prepare for transfer and careers in law, public service, international relations, and civic leadership." />
