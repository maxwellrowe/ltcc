	<ouc:properties label="metadata">
		<title>History Program | Lake Tahoe Community College</title>
		<meta name="Description" content="Explore the past and its impact on today with LTCC’s History program. Study world and U.S. history while building critical thinking skills for transfer and diverse career paths." />
	</ouc:properties>
	
