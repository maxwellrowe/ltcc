	<ouc:properties label="metadata">
		<title>English as a Second Language (ESL) Program | Lake Tahoe Community College</title>
		<meta name="Description" content="Improve your English skills with LTCC’s non-credit ESL program. Offering sequential courses from Low Beginning to Advanced, our curriculum focuses on listening, speaking, reading, and writing to support your language learning journey." />
	</ouc:properties>

