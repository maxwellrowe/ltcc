	<ouc:properties label="metadata">
		<title>Elementary Teacher Education | Lake Tahoe Community College</title>
		<meta name="Description" content="Start your path to becoming an elementary school teacher with LTCC’s Elementary Teacher Education program. Build foundational knowledge and prepare to transfer to a four-year teaching program." />
