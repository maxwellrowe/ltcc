	<ouc:properties label="metadata">
		<title>Allied Health Program | Lake Tahoe Community College</title>
		<meta name="Description" content="Start a career in healthcare with LTCC’s Allied Health programs. Gain foundational knowledge and hands-on training for entry into a variety of in-demand health professions." />
