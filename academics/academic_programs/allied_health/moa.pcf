	<ouc:properties label="metadata">
		<title>Medical Office Assistant | Lake Tahoe Community College</title>
		<meta name="Description" content="Start a career in healthcare with LTCC’s Medical Office Assistant program. Gain administrative and clinical skills to work in medical offices, clinics, and other healthcare settings." />
	</ouc:properties>

