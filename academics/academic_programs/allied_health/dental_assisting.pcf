	<ouc:properties label="metadata">
		<title>Dental Assisting Program | Lake Tahoe Community College</title>
		<meta name="Description" content="Start your career in healthcare with LTCC’s Dental Assisting program. Gain hands-on training and essential clinical skills to work in dental offices and support patient care." />
