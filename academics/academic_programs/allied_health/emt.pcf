	<ouc:properties label="metadata">
		<title>EMT Training Program | Lake Tahoe Community College</title>
		<meta name="Description" content="Join the EMT course at Lake Tahoe Community College and start your journey toward a rewarding career in health and public safety. Gain critical life-saving skills and fulfill vaccination requirements to support your enrollment. Secure your spot today." />
	</ouc:properties>

