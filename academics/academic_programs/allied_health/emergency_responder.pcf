	<ouc:properties label="metadata">
		<title>Emergency Medical Responder Course | Lake Tahoe Community College</title>
		<meta name="Description" content="Enroll in LTCC’s Emergency Medical Responder course to gain essential skills in life-saving care, first aid, and CPR. Complete the course and earn American Red Cross EMR and CPR/AED certifications." />
	</ouc:properties>

