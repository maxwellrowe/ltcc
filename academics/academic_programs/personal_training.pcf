	<ouc:properties label="metadata">
		<title>Personal Training | Lake Tahoe Community College</title>
		<meta name="Description" content="Start your fitness career with LTCC’s Personal Trainer Certification. Gain the knowledge and hands-on experience needed to become a certified personal trainer and help others achieve their health goals." />
	</ouc:properties>

