<div style="margin: 20px 0 15px 0;"><a class="custom-btn-blue-outline" style="padding: 8px 18px !important; font-size: 14px !important; display: inline-block;" title="View Program Map" href="https://pathways.ltcc.edu/program/019b1313-9555-7a5b-bb1c-88586f522df3/" target="_blank" rel="noopener"> &rarr; View Program Map </a></div>
