	<ouc:properties label="metadata">
		<title>Art Degree Program | Studio Art, Photography, Video &amp; Art History | Lake Tahoe Community College</title>
		<meta name="Description" content="Discover the Art degree program at Lake Tahoe Community College, featuring studio art, new media like photography and video, and art history. Build your skills and creativity in a collaborative, supportive environment for all experience levels." />
	</ouc:properties>

