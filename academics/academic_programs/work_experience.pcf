	<ouc:properties label="metadata">
		<title>Work-Based Learning &amp; Experience | Lake Tahoe Community College</title>
		<meta name="Description" content="Gain real-world experience with LTCC’s Work-Based Learning program. Apply classroom knowledge in professional settings, develop career skills, and receive faculty-supported, hands-on training to enhance your career readiness." />
	</ouc:properties>

