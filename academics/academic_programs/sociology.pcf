	<ouc:properties label="metadata">
		<title>Sociology Program | Lake Tahoe Community College</title>
		<meta name="Description" content="Study society, culture, and human behavior with LTCC’s Sociology program. Build a strong foundation for transfer and careers in social services, education, and public policy." />
	</ouc:properties>

