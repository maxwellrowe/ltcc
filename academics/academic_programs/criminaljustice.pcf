	<ouc:properties label="metadata">
		<title>Criminal Justice &amp; Administration of Justice | Lake Tahoe Community College</title>
		<meta name="Description" content="Prepare for careers in law enforcement and public safety with LTCC’s Criminal Justice &amp; Administration of Justice program. Learn the foundations of policing, law, and the justice system." />
	</ouc:properties>
	
