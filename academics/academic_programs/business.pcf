	<ouc:properties label="metadata">
		<title>Business Degree | Lake Tahoe Community College</title>
		<meta name="Description" content="Students engaging in a collaborative business lecture at Lake Tahoe Community College. The Business Administration program offers courses in economics, business law, ethics, entrepreneurship, and technology, with concentrations in accounting, finance, management, marketing, and small business ownership." />
	</ouc:properties>

