	<ouc:properties label="metadata">
		<title>Fire Overview | Lake Tahoe Community College</title>
		<meta name="Description" content="LTCC’s Fire Science program prepares students for entry-level fire service careers with hands-on skills and critical knowledge, following US Fire Academy standards." />
