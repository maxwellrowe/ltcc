	<ouc:properties label="metadata">
		<title>English Program | Lake Tahoe Community College</title>
		<meta name="Description" content="Strengthen your writing, reading, and critical thinking skills with LTCC’s English program. Prepare for transfer and careers in education, communications, and the humanities." />
