	<ouc:properties label="metadata">
		<title>Forestry Education &amp; Job Placement Program | Lake Tahoe Community College</title>
		<meta name="Description" content=" Enroll in Lake Tahoe Community College’s Forestry Education and Job Placement Program to build foundational knowledge and technical skills for forestry careers. Benefit from interdisciplinary study, hands-on field experiences, and preparation for advanced academic pursuits." />
	</ouc:properties>
	
