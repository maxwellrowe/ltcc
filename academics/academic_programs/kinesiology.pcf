	<ouc:properties label="metadata">
		<title>Physical Education &amp; Health Programs | Lake Tahoe Community College</title>
		<meta name="Description" content="Explore LTCC’s Physical Education &amp; Health programs, including an AA-T in Kinesiology and AA-S in Nutrition. Gain hands-on experience with courses in health, nutrition, and outdoor activities in the stunning Lake Tahoe region." />
	</ouc:properties>

