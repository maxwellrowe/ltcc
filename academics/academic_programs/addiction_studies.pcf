	<ouc:properties label="metadata">
		<title>Addiction Studies Program | Lake Tahoe Community College</title>
		<meta name="Description" content="Prepare for a career supporting recovery and community health with LTCC’s Addiction Studies program. Learn counseling fundamentals, prevention strategies, and pathways in behavioral health services." />
	</ouc:properties>

