	<ouc:properties label="metadata">
		<title>SLTPD Partnership Program | Lake Tahoe Community College</title>
		<meta name="Description" content="SLTPD employees can advance their careers through LTCC’s partnership program. Take online Criminal Justice and Administration of Justice courses to qualify for pay increases and promotional opportunities." />
	</ouc:properties>
	
