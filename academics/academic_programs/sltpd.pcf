<table class="ou-cta-green"><caption>Call-To-Action (Green)</caption>
<thead>
<tr>
<th>CTA Button</th>
<th>CTA Button</th>
<th>CTA Button</th>
</tr>
</thead>
<tbody>
<tr>
<td><a title="Apply Now" href="https://www.ltcc.edu/admissions/index.php" target="_blank" rel="noopener">Apply Now</a></td>
<td><a title="Visit Campus" href="https://www.ltcc.edu/admissions/campustours.php" target="_blank" rel="noopener">Visit Campus</a></td>
<td><a href="https://www.ltcc.edu/campusresources/counseling.php">Make a Plan</a></td>
</tr>
