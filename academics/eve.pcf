<?xml version="1.0" encoding="UTF-8"?>
<?pcf-stylesheet path="/_resources/xsl/interior.xsl" title="Interior Page" extension="php"?>
<?pcf-stylesheet path="/_resources/xsl/debug.xsl" title="Variable Debug" extension=".debug.html" publish="no" alternate="yes"?>

<!DOCTYPE document SYSTEM "http://commons.omniupdate.com/dtd/standard.dtd"> 

<document xmlns:ouc="http://omniupdate.com/XSL/Variables">
	
	<headcode></headcode> <!-- before closing head tag -->
	<bodycode></bodycode> <!-- after opening body tag -->
	<footcode></footcode> <!-- before closing body tag -->
	
	<ouc:info>
		<tcf>interior.tcf</tcf>
		<tmpl>interior.tmpl</tmpl>
	</ouc:info>
	
	<ouc:properties label="config">				
		<parameter name="heading" type="text" group="Everyone" prompt="Page Heading" alt="Enter the page heading text. Not displayed if left blank.">Enhanced Virtual Education</parameter>
		<parameter name="breadcrumb" type="text" group="Everyone" prompt="Breadcrumb" alt="Not displayed for index pages. Page title by default.">Enhanced Virtual Education</parameter>
		<parameter section="Top of Page Media" name="top-media" type="select" group="Everyone" prompt="Banner / Slider" alt="Choose between banner or slider for the top of the page media. Turn it off to hide the banner or use the snippet version.">
			<option value="slider" selected="true">Slider</option>
			<option value="banner" selected="false">Banner</option>
			<option value="off" selected="false">Off</option>
		</parameter>

		<parameter section="Banner Properties" name="banner" type="filechooser" group="Everyone" prompt="Banner Image" alt="Select a banner image."></parameter>
		<parameter name="banner-alt" type="text" group="Everyone" prompt="Banner Alt-Text" alt="Enter the alternate text for the banner image."></parameter>

		<parameter section="Page Layout" name="layout" type="select" group="Everyone" prompt="Number of Columns" alt="Switch between two or three column layout.">
			<option value="two" selected="true">Two Column</option>
			<option value="three" selected="false">Three Column</option>
		</parameter>		

		<parameter section="LDP Gallery" name="gallery-type" type="select" group="Everyone" prompt="Gallery Type" alt="Select the output type for gallery assets on this page.">			
			<option value="flex-slider" selected="true">Flex Slider</option>
			<option value="magnific-popup" selected="false">Magnific PopUp</option>
			<option value="pretty-photo" selected="false">Pretty Photo</option>
			<option value="fancy-box" selected="false">Fancy Box</option>
		</parameter>
	</ouc:properties>
	
	<ouc:properties label="metadata">
		<title>Enhanced Virtual Education</title>
		<meta name="Description" content="" />
	</ouc:properties>
	
	<ouc:div label="gallery" group="Everyone" button-text="Select Slider">
		<ouc:editor wysiwyg="gallery" csspath="/_resources/ou/editor/wysiwyg.css" cssmenu="/_resources/ou/editor/styles.txt"/>		
	</ouc:div>
	
	<ouc:div label="main-content" group="Everyone" button-text="Main Content"><ouc:editor csspath="/_resources/ou/editor/wysiwyg.css" cssmenu="/_resources/ou/editor/styles.txt" wysiwyg-class="main-content"/><p class="p1"><span class="s1"><img class="" style="display: block; margin-left: auto; margin-right: auto;" src="https://www.ltcc.edu/_resources/images/icons/eve_icon_new.png" alt="EVE Icon" width="435" height="301" /></span></p>
<p class="p1"><span class="s1">LTCC offers traditional distant education (DE) courses that provide independent learning and flexibility. For students who wish to have a face-to-face educational experience but in the safest way possible during COVID-19, LTCC introduces Enhanced Virtual Education, or EVE. </span></p>
<p class="p1"><span class="s1">Like traditional DE, EVE classes are also offered online and use the Canvas system for base information and resources, but they also use Zoom as well as other technologies to provide more &ldquo;real time&rdquo; contact. EVE classes are different than DE &ndash; they are intentionally designed for students who prefer a face-to-face, classroom feel. In EVE classes, you&rsquo;ll experience:</span></p>
<table class="ou-chevron-list"><caption>Chevron List</caption>
<thead>
<tr>
<th>Add bulleted list here</th>
</tr>
</thead>
<tbody>
<tr>
<td>
<ul>
<li>A high-touch environment with extra support</li>
<li>Labs offered in a virtual environment</li>
<li>Lots of discussion and interaction with your teacher and fellow students</li>
<li>One-on-one support from faculty, including virtual office hours</li>
<li>Discussions, interactions, projects with faculty and other students offered in "real-time"</li>
<li>Some synchronous&nbsp;elements/course content offered during the scheduled course days and times</li>
<li>Other asynchronous elements/course content moved to virtual environment</li>
</ul>
</td>
</tr>
</tbody>
</table>
<p style="text-align: center;"><a title="Course Schedule" href="https://www.ltcc.edu/academics/scheduleofclasses.php" target="_blank"><span style="font-size: 14pt;">Check out the course schedule&nbsp;&rarr;&nbsp;</span></a></p></ouc:div>

	<ouc:div label="right-content" group="Everyone" button-text="Right Column Content">
		<ouc:editor csspath="/_resources/ou/editor/wysiwyg.css" cssmenu="/_resources/ou/editor/styles.txt" wysiwyg-class="right-content"/>
		<h2>Edit Title</h2>
		<p>Edit Content</p>
	</ouc:div>
	
</document>
