<th>CTA Button</th>
</tr>
</thead>
<tbody>
<tr>
<td><a href="https://www.ltcc.edu/academics/virtual_campus/virtualcampusstudentsupport.php">Student Support</a></td>
<td><a href="https://www.ltcc.edu/academics/virtual_campus/virtualcampusfacultysupport.php">Faculty Support</a></td>
<td><a href="https://www.ltcc.edu/academics/virtual_campus/virtualstaff.php">Staff Support</a></td>
</tr>
</tbody>
</table>
