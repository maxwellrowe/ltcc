	<ouc:properties label="metadata">
		<title>Common Course Numbering | Lake Tahoe Community College</title>
		<meta name="Description" content="Find answers to your questions about LTCC’s common course numbering system. Learn how course numbers align across colleges to simplify transfer and academic planning." />
