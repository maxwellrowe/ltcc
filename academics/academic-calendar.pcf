<?xml version="1.0" encoding="UTF-8"?>
<?pcf-stylesheet path="/_resources/xsl/interior.xsl" title="Interior Page" extension="php"?>
<?pcf-stylesheet path="/_resources/xsl/debug.xsl" title="Variable Debug" extension=".debug.html" publish="no" alternate="yes"?>

<!DOCTYPE document SYSTEM "http://commons.omniupdate.com/dtd/standard.dtd"> 

<document xmlns:ouc="http://omniupdate.com/XSL/Variables">
	
	<headcode>
		<style>
			table tbody tr td {
			    border: none;
			}
		</style>
	</headcode> <!-- before closing head tag -->
	<bodycode></bodycode> <!-- after opening body tag -->
	<footcode></footcode> <!-- before closing body tag -->
	
	<ouc:info>
		<tcf>interior.tcf</tcf>
		<tmpl>interior.tmpl</tmpl>
	</ouc:info>
	
	<ouc:properties label="config">				
		<parameter name="heading" type="text" group="Everyone" prompt="Page Heading" alt="Enter the page heading text. Not displayed if left blank."></parameter>
		<parameter name="breadcrumb" type="text" group="Everyone" prompt="Breadcrumb" alt="Not displayed for index pages. Page title by default.">Academic Calendar</parameter>
		<parameter section="Top of Page Media" name="top-media" type="select" group="Everyone" prompt="Banner / Slider" alt="Choose between banner or slider for the top of the page media. Turn it off to hide the banner or use the snippet version.">
<option value="slider" selected="false">Slider</option>
<option value="banner" selected="false">Banner</option>
<option value="off" selected="true">Off</option>
</parameter>

		<parameter section="Banner Properties" name="banner" type="filechooser" group="Everyone" prompt="Banner Image" alt="Select a banner image."></parameter>
		<parameter name="banner-alt" type="text" group="Everyone" prompt="Banner Alt-Text" alt="Enter the alternate text for the banner image."></parameter>

		<parameter section="Page Layout" name="layout" type="select" group="Everyone" prompt="Number of Columns" alt="Switch between two or three column layout.">
<option value="two" selected="true">Two Column</option>
<option value="three" selected="false">Three Column</option>
</parameter>		

		<parameter section="LDP Gallery" name="gallery-type" type="select" group="Everyone" prompt="Gallery Type" alt="Select the output type for gallery assets on this page.">
<option value="flex-slider" selected="true">Flex Slider</option>
<option value="magnific-popup" selected="false">Magnific PopUp</option>
<option value="pretty-photo" selected="false">Pretty Photo</option>
<option value="fancy-box" selected="false">Fancy Box</option>
</parameter>
	</ouc:properties>
	
	<ouc:properties label="metadata">
		<title>Academic Calendar </title>
		<meta name="Description" content="Stay informed with the Lake Tahoe Community College Academic Calendar. Explore key dates for classes, exams, holidays, and events to plan your semester effectively." />
	</ouc:properties>

	<ouc:div label="gallery" group="Everyone" button-text="Select Slider">
		<ouc:editor wysiwyg="gallery" csspath="/_resources/ou/editor/wysiwyg.css" cssmenu="/_resources/ou/editor/styles.txt"/>		
	</ouc:div>

	<ouc:div label="main-content" group="Everyone" button-text="Main Content"><ouc:editor csspath="/_resources/ou/editor/wysiwyg.css" cssmenu="/_resources/ou/editor/styles.txt" wysiwyg-class="main-content"/><!-- ============================================================
     ACADEMIC CALENDAR PAGE
     Editors: you should not need to change anything on this page.
     To update dates, edit the ASSET for that quarter instead:
       Fall    = <em class="ou-je-asset ou-je-placeholder mceNonEditable" data-ou-asset-id="171403">Asset_171403</em>
       Winter  = (asset to be created)
       Spring  = <em class="ou-je-asset ou-je-placeholder mceNonEditable" data-ou-asset-id="375793">Asset_375793</em>
       Summer  = <em class="ou-je-asset ou-je-placeholder mceNonEditable" data-ou-asset-id="171400">Asset_171400</em>
     Only change the year in a heading below when a quarter rolls over.
     ============================================================ -->
<div class="snippet-spacer">
<table class="ou-static-banner"><caption>Static Banner Image</caption>
<tbody>
<tr>
<th>Title</th>
<td>Academic Calendar</td>
</tr>
<tr>
<th>Image</th>
<td><img src="https://www.ltcc.edu/_resources/images/campus_drone_1200.jpg" alt="" width="1200" height="460" aria-hidden="true" /></td>
</tr>
</tbody>
</table>
</div>
<div class="btn-wrapper">&nbsp;</div>
<div class="btn-wrapper"><a class="custom-btn-blue" href="https://passport.ltcc.edu">Check Your Registration Date in Passport</a></div>
<h2>Fall 2026</h2>
{{a:171403}}
<h2>Winter 2027</h2>
{{a:375792}}
<h2>Spring 2027</h2>
{{a:375793}}
<h2>Summer 2027</h2>
<p><em>Coming soon!</em></p></ouc:div>
  	
  	<ouc:div label="right-content" group="Everyone" button-text="Right Column Content">
		<ouc:editor csspath="/_resources/ou/editor/wysiwyg.css" cssmenu="/_resources/ou/editor/styles.txt" wysiwyg-class="right-content"/>
		
	</ouc:div>
  	
</document>
