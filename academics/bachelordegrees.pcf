	<ouc:properties label="metadata">
		<title>Bachelor's Degree Programs | Lake Tahoe Community College</title>
		<meta name="Description" content="Explore bachelor’s degree opportunities available through LTCC partnerships and transfer pathways. Take the next step toward advanced education and career success." />
	</ouc:properties>
	
