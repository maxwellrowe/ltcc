<!DOCTYPE document SYSTEM "http://commons.omniupdate.com/dtd/standard.dtd"> 

<document xmlns:ouc="http://omniupdate.com/XSL/Variables">
	
	<headcode>
		<style>
			.center {
			    text-align: center;
			}
			
			.catalogImg {
				border: solid 1px;
				border-radius: 5px;
			}
			
			.catalogImg:hover {
				box-shadow: 0 0 25px #00f;
			}
			
		</style>
	</headcode> <!-- before closing head tag -->
	<bodycode></bodycode> <!-- after opening body tag -->
	<footcode></footcode> <!-- before closing body tag -->
	
	<ouc:info>
		<tcf>interior.tcf</tcf>
		<tmpl>interior.tmpl</tmpl>
	</ouc:info>
	
	<ouc:properties label="config">				
		<parameter name="heading" type="text" group="Everyone" prompt="Page Heading" alt="Enter the page heading text. Not displayed if left blank.">Catalog</parameter>
		<parameter name="breadcrumb" type="text" group="Everyone" prompt="Breadcrumb" alt="Not displayed for index pages. Page title by default.">Catalog</parameter>
		<parameter section="Top of Page Media" name="top-media" type="select" group="Everyone" prompt="Banner / Slider" alt="Choose between banner or slider for the top of the page media.">
<option value="slider" selected="false">Slider</option>
<option value="banner" selected="false">Banner</option>
<option value="off" selected="true">Off</option>
</parameter>

		<parameter section="Banner Properties" name="banner" type="filechooser" group="Everyone" prompt="Banner Image" alt="Select a banner image."></parameter>
		<parameter name="banner-alt" type="text" group="Everyone" prompt="Banner Alt-Text" alt="Enter the alternate text for the banner image."></parameter>

		<parameter section="Page Layout" name="layout" type="select" group="Everyone" prompt="Number of Columns" alt="Switch between two or three column layout.">
<option value="two" selected="true">Two Column</option>
<option value="three" selected="false">Three Column</option>
</parameter>		

		<parameter section="LDP Gallery" name="gallery-type" type="select" group="Everyone" prompt="Gallery Type" alt="Select the output type for gallery assets on this page.">
<option value="flex-slider" selected="true">Flex Slider</option>
<option value="magnific-popup" selected="false">Magnific PopUp</option>
<option value="pretty-photo" selected="false">Pretty Photo</option>
<option value="fancy-box" selected="false">Fancy Box</option>
</parameter>
	</ouc:properties>
	
	<ouc:properties label="metadata">
		<title>College Catalog | Lake Tahoe Community College</title>
		<meta name="Description" content="Explore LTCC’s College Catalog for detailed information on academic programs, course descriptions, degree requirements, policies, and student resources—all in one convenient place." />
	</ouc:properties>

	<ouc:div label="gallery" group="Everyone" button-text="Select Slider">
		<ouc:editor wysiwyg="gallery" csspath="/_resources/ou/editor/wysiwyg.css" cssmenu="/_resources/ou/editor/styles.txt"/>		
	</ouc:div>

	<ouc:div label="main-content" group="Everyone" button-text="Main Content"><ouc:editor csspath="/_resources/ou/editor/wysiwyg.css" cssmenu="/_resources/ou/editor/styles.txt" wysiwyg-class="main-content"/><p>The Lake Tahoe Community College catalog includes extensive information about our campus, services, programs, and classes. The catalog is published annually each June for the upcoming academic year.</p>
<div class="btn-wrapper"><a class="custom-btn-blue" title="Open the 2026/2027 LTCC Catalog" href="https://ltcc.elumenapp.com/catalog/2026-2027/about-this-catalog" target="_blank" rel="noopener">View 26/27 Catalog</a></div>
<p style="text-align: center;">&nbsp;</p>
