	<headcode>	
		<style>
			
			.main {
				max-width: 1000px;
				margin: 5px auto;
				text-align: center;
			}
			
			.myul {
			    float: left;
				max-width: 450px;
				margin: 0 auto;
				padding: 5%;

			}
			
			.myul a {
				text-decoration: none;
				
			}
			
			.myul li {
			    list-style: none;
			    text-align: center;
			}
			
			.contact {
			    margin: 0 auto;
			    text-align: center;
			}
			
			.myul img {
				display: block;
				margin: 0 auto;
				border: solid 1px;
				border-radius: 5px;
			} 
			
			.myul img:hover {
				box-shadow: 0 0 25px #007a3d;
				border: solid 1px #007a3d;
			}
			
			.clear {
				clear: both;
			}
			
			
			@media screen and (max-width: 1020px) {
				.myul {
					float: none;
				}
			
			}
			
		</style>
	</headcode> <!-- before closing head tag -->
