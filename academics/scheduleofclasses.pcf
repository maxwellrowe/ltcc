	<ouc:properties label="metadata">
		<title>Schedule of Classes | Lake Tahoe Community College</title>
		<meta name="Description" content="Explore the schedule of classes at Lake Tahoe Community College. Find courses across various disciplines, plan your semester, and advance your education with flexible class options to fit your goals and lifestyle. Enroll now." />
	</ouc:properties>
	
