<?php /* Uses xsl/alert.xsl to publish alert.php, loaded near the top of pages by common.xsl and the anniversary theme. */ ?>

	
	<headcode></headcode> <!-- before closing head tag -->
	<bodycode></bodycode> <!-- after opening body tag -->
	<footcode></footcode> <!-- before closing body tag -->
	

	
	<ouc:properties label="metadata">
		<title>Alert</title>
		<meta name="Description" content="" />
	</ouc:properties>
	
	<ouc:div label="main-content" group="Everyone" button-text="Main Content"><ouc:editor csspath="/_resources/ou/editor/wysiwyg.css" cssmenu="/_resources/ou/editor/styles.txt" wysiwyg-class="main-content"/><ouc:component name="component-alert">
        <ul>
            <li class="start"></li>
            <li class="end"></li>
            <li class="display">hide</li>
            <li class="style">default</li>
            <li class="dismissible">true</li>
            <li class="title">Campus Closed - All Staff Training Day</li>
            <li class="content"><p>LTCC will be closed Friday, August 28 for all staff training. Services resume Saturday, August 29.</p></li>
            <li class="button-text"></li>
            <li class="button-link"></li>
            <li class="icon">fa-bell</li>
        </ul>
    </ouc:component></ouc:div>
	
