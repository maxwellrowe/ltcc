		<parameter name="address-2" type="text" group="Everyone" prompt="Address Line #2" alt="">Tahoe, CA 96150</parameter>
		<parameter name="phone" type="text" group="Everyone" prompt="Phone" alt="">530-541-4660</parameter>
		<parameter name="hours-1" type="text" group="Everyone" prompt="Campus Hours Line #1" alt="">Campus Hours</parameter>
		<parameter name="hours-2" type="text" group="Everyone" prompt="Campus Hours Line #2" alt="">Monday-Thursday: 7:30am-10pm</parameter>
		<parameter name="hours-3" type="text" group="Everyone" prompt="Campus Hours Line #3" alt="">Friday: 7:30am-6:30pm</parameter>
		<parameter section="Copyright" name="copyright-1" type="text" group="Everyone" prompt="Before Copyright" alt="">Lake Tahoe Community College -</parameter>
		<parameter name="copyright-2" type="text" group="Everyone" prompt="After Copyright" alt="">2024 All Rights Reserved</parameter>
