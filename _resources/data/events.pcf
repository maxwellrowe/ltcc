	<ouc:properties label="metadata">
	</ouc:properties>

	<!--
The dsn is used to filter out XMLs during aggregation that do not have a matching dsn attribute value.
When the dsn value is left empty it defaults to the name of this pcf without the extension.
-->
	<parameter name="dsn">events</parameter>

