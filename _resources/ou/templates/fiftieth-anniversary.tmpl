<?xml version="1.0" encoding="UTF-8"?>
<?pcf-stylesheet path="/_resources/xsl/fiftieth-anniversary.xsl" title="Interior Page" extension="php"?>
<?pcf-stylesheet path="/_resources/xsl/debug.xsl" title="Variable Debug" extension=".debug.html" publish="no" alternate="yes"?>

<!DOCTYPE document SYSTEM "http://commons.omniupdate.com/dtd/standard.dtd"> 

<document xmlns:ouc="http://omniupdate.com/XSL/Variables">
	
	<headcode></headcode> <!-- before closing head tag -->
	<bodycode></bodycode> <!-- after opening body tag -->
	<footcode></footcode> <!-- before closing body tag -->
	
	<ouc:info>
		<tcf><!--%echo var="tcfname" --></tcf>
		<tmpl>interior.tmpl</tmpl>
	</ouc:info>
	
	<ouc:properties label="config">				
		<parameter name="heading" type="text" group="Everyone" prompt="Page Heading" alt="Enter the page heading text. Not displayed if left blank."><!--%echo var="title" --></parameter>
		<parameter name="breadcrumb" type="text" group="Everyone" prompt="Breadcrumb" alt="Not displayed for index pages. Page title by default."><!--%echo var="title" --></parameter>
		<parameter section="Top of Page Media" name="top-media" type="select" group="Everyone" prompt="Banner / Slider" alt="Choose between banner or slider for the top of the page media. Turn it off to hide the banner or use the snippet version.">
			<option value="slider" selected="true">Slider</option>
			<option value="banner" selected="false">Banner</option>
			<option value="off" selected="false">Off</option>
		</parameter>
		<parameter name="page-id" type="text" group="Everyone" prompt="Unique Page ID" alt="Will apply a unique ID to the wrapping div of the page."></parameter>
		<parameter section="Header" name="mkt-header" type="select" group="Everyone" prompt="Which header do you want to use for this page?">
			<option value="fiftieth-header" selected="true">50th Anniversary Header</option>
			<option value="global-header" selected="false">Global Header</option>
		</parameter>

	</ouc:properties>
	
	<ouc:properties label="metadata">
		<title><!--%echo var="title" --></title>
		<meta name="Description" content="<!--%echo var='description' -->" />
	</ouc:properties>
	
	<ouc:div label="gallery" group="Everyone" button-text="Select Slider">
		<ouc:editor wysiwyg="gallery" csspath="/_resources/ou/editor/wysiwyg.css" cssmenu="/_resources/ou/editor/styles.txt"/>		
	</ouc:div>
	
	<ouc:div label="main-content" group="Everyone" button-text="Main Content">
		<ouc:editor csspath="/_resources/ou/editor/wysiwyg.css" cssmenu="/_resources/ou/editor/styles.txt" wysiwyg-class="main-content"/>
		<p>Edit Content</p>	
	</ouc:div>

	<ouc:div label="right-content" group="Everyone" button-text="Right Column Content">
		<ouc:editor csspath="/_resources/ou/editor/wysiwyg.css" cssmenu="/_resources/ou/editor/styles.txt" wysiwyg-class="right-content"/>
		<h2>Edit Title</h2>
		<p>Edit Content</p>
	</ouc:div>
	
</document>
